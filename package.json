{
  "name": "souls-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "build:models": "node scripts/build-models.mjs",
    "build:models:clean": "node scripts/build-models.mjs --clean",
    "watch:models": "node scripts/build-models.mjs --watch",
    "build:sfx": "node scripts/process-sfx.mjs",
    "inspect:model": "node scripts/inspect-model.mjs",
    "inspect:fbx": "blender --background --python scripts/inspect-fbx.py --",
    "capture:anims": "playwright test tests/animation-capture.spec.ts",
    "build:model": "blender --background --python scripts/process_mixamo.py --",
    "convert:unrigged": "blender --background --python convert_unrigged.py",
    "verify:visual": "playwright test tests/visual.spec.ts",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.184.0",
    "three.quarks": "^0.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.184.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
